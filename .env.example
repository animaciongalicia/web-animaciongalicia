# URL pública del dominio (sin barra final y SIN subcarpeta). Producción: https://animaciongalicia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo "true" en el entorno de producción cuando se active el dominio.
# En cualquier otro caso la web va con noindex y robots.txt bloqueado.
SITE_INDEXABLE=false

# Los formularios abren el programa de correo del usuario (mailto:) hacia info@animaciongalicia.com: no necesitan servidor ni variables.

# Subcarpeta donde vive la revista dentro del dominio. Recomendado: /revista
# (animaciongalicia.com ya es una web WordPress en producción: la revista NO debe ocupar la raíz).
# Vacío = raíz del dominio.
NEXT_PUBLIC_BASE_PATH=

# Google Analytics 4 (por defecto G-JY6XXV50MM). Solo se carga en producción (SITE_INDEXABLE=true) y tras aceptar las cookies.
NEXT_PUBLIC_GA_ID=G-JY6XXV50MM
