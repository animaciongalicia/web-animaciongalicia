# URL pública del sitio (sin barra final). Dominio aún por decidir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo "true" en el entorno de producción cuando se active el dominio.
# En cualquier otro caso la web va con noindex y robots.txt bloqueado.
SITE_INDEXABLE=false

# Formulario de contacto (opcional). Sin esto funciona en MODO DE PRUEBA y no envía nada.
# Proveedor soportado: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
